# !STARTERCONF Duplicate this to .env.local

# DEVELOPMENT TOOLS
# Ideally, don't add them to production deployment envs
# !STARTERCONF Change to true if you want to log data
NEXT_PUBLIC_SHOW_LOGGER="false"

# Chat (server-only, set these in Vercel too)
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
# Login OTP secret. Generate with: pnpm otp:setup
CHAT_TOTP_SECRET=""

# File transfer (/send). Created automatically when you add a Blob store to the
# Vercel project (Storage > Blob). Without it, local dev stores files in .data/
BLOB_READ_WRITE_TOKEN=""

# Online multiplayer (/games/connect4). Create a free Upstash Redis database, or
# add Upstash from the Vercel Marketplace, then copy its REST URL and token.
# (KV_REST_API_URL / KV_REST_API_TOKEN from the Vercel integration also work.)
# Without these, local dev keeps rooms in memory and production answers 503.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Snake Duel uses Vercel WebSockets (Fluid Compute) and the Redis credentials above.
# Set to 1 on the deployment that should offer Arena rooms.
SNAKE_DUEL_ENABLED="0"
SNAKE_DUEL_MONTHLY_ROUNDS="20"
# Optional. Vercel defaults to separate preview and production Arena namespaces.
# SNAKE_DUEL_NAMESPACE="preview"

# Admin dashboard (/admin). Optional in local dev (open without login); required in production.
ADMIN_PASSWORD=""

# Fixed-origin AI Relay (/v1/...), compatible with OpenAI/Anthropic/9Router clients.
# RELAY_API_KEY must be at least 32 characters; UPSTREAM_ORIGIN must be an HTTPS origin.
RELAY_API_KEY=""
UPSTREAM_ORIGIN=""
UPSTREAM_API_KEY=""
